# ─────────────────────────────────────────────────────────────────────────────
# Variables PÚBLICAS del cliente (se exponen al navegador, sujetas a RLS).
# Prefijo VITE_ obligatorio. NUNCA poner aquí claves privilegiadas (service_role).
# ─────────────────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL="http://127.0.0.1:54321"
VITE_SUPABASE_ANON_KEY="<anon key local de 'supabase start'>"

# ─────────────────────────────────────────────────────────────────────────────
# Secretos SOLO de servidor (funciones en /api). SIN prefijo VITE_.
# No se empaquetan en el bundle del cliente.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="<service_role key local — jamás commitear ni exponer>"
# Origen autorizado para las funciones (CORS / validación de referer)
APP_ORIGIN="http://127.0.0.1:5173"

# ─────────────────────────────────────────────────────────────────────────────
# Formulario web público → Oportunidades (api/lead-web.ts). SOLO servidor.
# ─────────────────────────────────────────────────────────────────────────────
# UUID del usuario Dirección (auth.users) dueño de las consultas web entrantes.
INBOUND_OWNER_ID="<uuid del usuario Dirección>"
# Origen del sitio público (arpeco-web) autorizado por CORS en /api/lead-web.
WEB_ORIGIN="https://grupoarpeco.com"
